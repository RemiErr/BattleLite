# BattleLite Environment Variables Template

# === Lobby Server Address ===
# 切換時只改 LOBBY_USE_LOCAL: true=同網域本機/第三方主機, false=雲端
LOBBY_USE_LOCAL=true

LOBBY_SERVER_URL_LOCAL=ws://localhost:8000
LOBBY_SERVER_URL_CLOUD=wss://your-lobby-server.com

# === Self-hosted Lobby (第三方主機備援) ===
# 用 scripts/gen_lobby_keypair.py 一鍵產生 keypair；
# 私鑰填這裡，公鑰覆寫 config/lobby_pubkey.txt 並分發給每台 client。
LOBBY_SIGNING_KEY=

# Google Sheets webhook（留空則停用排行榜上拋，不影響遊戲）
SHEETS_WEBHOOK_URL=

# === UDP Relay (TURN-like fallback) ===
# Relay 與 lobby 同 process；填這台主機對 client 可達的 IP。
# 同網段填 LAN IP (e.g. 192.168.1.50)，公網 VPS 填公網 IP。
RELAY_PUBLIC_IP=
RELAY_UDP_PORT=9000
